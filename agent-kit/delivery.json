{
  "schemaVersion": 1,
  "packageVersion": "0.9.2-wiki.1",
  "distribution": {
    "startHere": "https://raw.githubusercontent.com/clark874/siyuan-plugins-mcp-sisyphus/v0.9.2-wiki.1/agent-kit/START-HERE.md",
    "archive": "https://github.com/clark874/siyuan-plugins-mcp-sisyphus/releases/download/v0.9.2-wiki.1/siyuan-agent-kit.zip",
    "stableChannel": "https://raw.githubusercontent.com/clark874/siyuan-plugins-mcp-sisyphus/codex/local-maintenance/release-channel.json"
  },
  "externalGateway": {
    "name": "siyuan",
    "implementation": "Sisyphus MCP",
    "url": "http://127.0.0.1:36806/mcp",
    "transport": "http",
    "authentication": "bearer-token-from-local-client",
    "clientRegistration": "required"
  },
  "officialMcp": {
    "implementation": "SiYuan built-in MCP",
    "url": "http://127.0.0.1:6806/mcp",
    "installation": "included-with-siyuan",
    "role": "internal-extension-bus",
    "clientRegistration": "forbidden"
  },
  "firstCall": {
    "tool": "system",
    "action": "bootstrap",
    "expectedSchemaVersion": 2
  },
  "installers": {
    "kimiCode": "node scripts/install-agent-kit.mjs --client kimi",
    "zcode": "node scripts/install-agent-kit.mjs --client zcode",
    "pluginUpdateCheck": "node scripts/update-sisyphus.mjs",
    "pluginUpdateApply": "node scripts/update-sisyphus.mjs --apply"
  },
  "security": {
    "containsCredential": false,
    "printsCredential": false,
    "removesExistingOfficialMcp": false
  }
}
