  "system": {
    "actions": {
      "apply_change": {
        "action": "apply_change",
        "cliExamples": [
          "siyuan-sisyphus system apply-change --plan-id <planID> --validate-only",
          "siyuan-sisyphus system apply-change --plan-id <planID> --expected-state-hash <preflight-credential> --request-id <uuidv7>",
        ],
